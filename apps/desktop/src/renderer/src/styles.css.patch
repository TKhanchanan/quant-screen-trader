/* NEW DASHBOARD STYLES */
.app-layout {
  display: flex;
  min-height: 100vh;
  background: #080d18;
}

.app-sidebar {
  width: 260px;
  background: #0f172a;
  border-right: 1px solid #1e293b;
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
}

.app-sidebar__brand {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 40px;
  padding: 0 8px;
}

.app-logo {
  width: 32px;
  height: 32px;
  background: #3b82f6;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  color: white;
}

.app-name {
  font-size: 14px;
  font-weight: 700;
  line-height: 1.2;
}

.app-sidebar__nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  color: #94a3b8;
  text-decoration: none;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.2s ease;
}

.nav-item:hover, .nav-item--active {
  background: #1e293b;
  color: #f8fafc;
}

.nav-item--active {
  background: #1e40af20;
  color: #60a5fa;
}

.app-sidebar__bottom {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: auto;
}

.app-main {
  flex: 1;
  padding: 32px 48px;
  overflow-y: auto;
  background: radial-gradient(circle at 50% 0%, rgb(38 107 255 / 5%), transparent 40rem);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}

.status-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  background: #064e3b30;
  border: 1px solid #05966950;
  border-radius: 999px;
  color: #34d399;
  font-size: 12px;
  font-weight: 600;
}

.user-profile {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  cursor: pointer;
}

.user-avatar {
  background: #334155;
  border-radius: 50%;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-tabs {
  display: flex;
  gap: 12px;
  margin: 30px 0;
}

.tab-button {
  padding: 8px 16px;
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 8px;
  color: #cbd5e1;
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  transition: background 0.2s;
}

.tab-button:hover {
  background: #334155;
}

.platform-card__title {
  display: flex;
  align-items: center;
  gap: 16px;
}

.health-panel__title-group {
  display: flex;
  align-items: center;
  gap: 16px;
}

.health-icon {
  font-size: 24px;
  background: #064e3b30;
  padding: 12px;
  border-radius: 12px;
}

.health-grid-item {
  display: flex;
  align-items: center;
  gap: 12px;
}

.health-grid-icon {
  font-size: 20px;
  opacity: 0.5;
}

.status-ok {
  color: #34d399;
}
