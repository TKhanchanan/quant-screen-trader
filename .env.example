# Safe local defaults. Never place credentials, cookies, or session data here.
QST_ENGINE_HOST=127.0.0.1
QST_ENGINE_PORT=8765
QST_LOG_LEVEL=info

# Optional absolute paths; leave blank to use the platform defaults.
QST_DATA_DIR=
QST_PYTHON_EXECUTABLE=
# Optional HTTPS entry paths on allowlisted platform origins; blank uses defaults.
QST_CAPITALBEAR_START_URL=
QST_IQOPTION_START_URL=

# Paper simulation (Phase 9). Directional outcomes are always recorded; simulated money is
# reported only when all three accounting values are set together. There is no default stake
# or payout rate, and nothing here is read from a broker.
QST_PAPER_ENABLED=true
QST_PAPER_REQUIRE_READY_BOARD=true
QST_PAPER_CURRENCY=
QST_PAPER_STAKE=
QST_PAPER_PAYOUT_RATE=
